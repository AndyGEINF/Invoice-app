# ---------------------------------------------------------------------------
# INVOICE — configuración de entorno
#
# AVISO: la aplicación NO tiene login. Ejecútala en tu equipo (localhost) o en
# una red privada. Si la expones a Internet, protege el acceso fuera de la
# aplicación (proxy con contraseña, VPN). Ver docs/deploy.md.
# ---------------------------------------------------------------------------

APP_NAME=INVOICE
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Base de datos: PostgreSQL 17 (única conexión) --------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=invoice
DB_USERNAME=invoice
DB_PASSWORD=

# --- Sesión, caché y cola ---------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
CACHE_STORE=database

# La cola usa la base de datos: ejecuta `php artisan queue:work` para PDFs,
# emails y validación VIES. En desarrollo puedes usar `sync`.
QUEUE_CONNECTION=database

# Opcional: Redis para colas/caché (no necesario).
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# --- Almacenamiento ---------------------------------------------------------
FILESYSTEM_DISK=local
# PDFs emitidos: 'documents' (local, storage/app/private/documents) o 's3'
INVOICE_DOCUMENTS_DISK=documents
# Logotipos: 'logos' (storage/app/public/logos, requiere `php artisan storage:link`)
INVOICE_LOGOS_DISK=logos

# Opcional: S3 compatible (AWS, MinIO…)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=eu-west-1
# AWS_BUCKET=
# AWS_ENDPOINT=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Email ------------------------------------------------------------------
# En local, los emails se escriben en storage/logs/laravel.log.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="facturas@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Para enviar de verdad, configura tu cuenta SMTP:
# MAIL_MAILER=smtp
# MAIL_SCHEME=null
# MAIL_HOST=smtp.tu-proveedor.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=

# --- PDF (Browsershot / Chromium) -------------------------------------------
# Ruta al ejecutable de Chrome/Chromium. Vacío = buscar en el PATH.
# En Windows usa comillas SIMPLES (las dobles rompen con las barras invertidas):
# BROWSERSHOT_CHROME_PATH='C:\Program Files\Google\Chrome\Application\chrome.exe'
BROWSERSHOT_CHROME_PATH=
BROWSERSHOT_NODE_BINARY=
BROWSERSHOT_NPM_BINARY=
BROWSERSHOT_TIMEOUT=60

VITE_APP_NAME="${APP_NAME}"
